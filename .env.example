
# PostgreSQL
POSTGRES_USER=commerce_user
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=commerce_db

# Redis
REDIS_PASSWORD=change_this_redis_password

# Application connections (API currently on host)
DATABASE_URL=postgresql+psycopg://commerce_user:change_this_local_password@localhost:5432/commerce_db
REDIS_URL=redis://:change_this_redis_password@localhost:6379/0

# JWT
JWT_SECRET=secret
JWT_ALGORITHM=algo_name
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=20

# Application
APP_ENV=development
